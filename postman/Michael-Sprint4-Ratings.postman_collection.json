{
  "info": {
    "name": "Michael Sprint 4 - Ratings & Comments",
    "description": "Run after the user, book, and ratings seeds with the API started. Looks up charlie.tech and the top-selling book, then tests all four Book Rating and Commenting endpoints, including one rating per user per book and 204 responses for both POSTs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup: find user charlie.tech",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('userId', pm.response.json()._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users/charlie.tech"
      }
    },
    {
      "name": "Setup: pick top-selling book",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const books = pm.response.json();",
              "pm.test('At least one book', () => pm.expect(books.length).to.be.above(0));",
              "pm.collectionVariables.set('bookId', books[0]._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/top-sellers"
      }
    },
    {
      "name": "1. Rate the book 1 star (204, no body)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204', () => pm.response.to.have.status(204));",
              "pm.test('No response body', () => pm.expect(pm.response.text()).to.eql(''));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/books/{{bookId}}/rating",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"{{userId}}\", \"rating\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. Average after 1-star rating",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('Has bookId, averageRating, ratingCount', () => pm.expect(r).to.have.keys('bookId', 'averageRating', 'ratingCount'));",
              "pm.test('averageRating is a decimal from 1 to 5', () => pm.expect(r.averageRating).to.be.within(1, 5));",
              "pm.collectionVariables.set('countAfterFirst', r.ratingCount);",
              "pm.collectionVariables.set('avgAfterFirst', r.averageRating);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/{{bookId}}/rating"
      }
    },
    {
      "name": "3. Same user rates again with 5 stars (204, replaces old rating)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204', () => pm.response.to.have.status(204));",
              "pm.test('No response body', () => pm.expect(pm.response.text()).to.eql(''));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/books/{{bookId}}/rating",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"{{userId}}\", \"rating\": 5}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "4. Average: count unchanged, average went up",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "const count = Number(pm.collectionVariables.get('countAfterFirst'));",
              "const before = Number(pm.collectionVariables.get('avgAfterFirst'));",
              "pm.test('No duplicate rating: ratingCount unchanged', () => pm.expect(r.ratingCount).to.eql(count));",
              "pm.test('Average rose by (5 - 1) / count', () => pm.expect(r.averageRating).to.be.closeTo(before + 4 / count, 0.011));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/{{bookId}}/rating"
      }
    },
    {
      "name": "5. Rating out of range (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Error message', () => pm.expect(pm.response.json().error).to.eql('rating must be a whole number from 1 to 5'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/books/{{bookId}}/rating",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"{{userId}}\", \"rating\": 6}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. Rating not a whole number (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Error message', () => pm.expect(pm.response.json().error).to.eql('rating must be a whole number from 1 to 5'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/books/{{bookId}}/rating",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"{{userId}}\", \"rating\": 3.5}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "7. Rating sent as a string (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Error message', () => pm.expect(pm.response.json().error).to.eql('rating must be a whole number from 1 to 5'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/books/{{bookId}}/rating",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"{{userId}}\", \"rating\": \"5\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "8. Missing userId (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Error message', () => pm.expect(pm.response.json().error).to.eql('Valid userId is required'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/books/{{bookId}}/rating",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"rating\": 3}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "9. User not found (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('Error message', () => pm.expect(pm.response.json().error).to.eql('User not found'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/books/{{bookId}}/rating",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"000000000000000000000000\", \"rating\": 3}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10. Book not found (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('Error message', () => pm.expect(pm.response.json().error).to.eql('Book not found'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/books/000000000000000000000000/rating",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"{{userId}}\", \"rating\": 3}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11. Invalid bookId (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Error message', () => pm.expect(pm.response.json().error).to.eql('Invalid bookId'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/books/not-an-id/rating",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"{{userId}}\", \"rating\": 3}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "12. Add a comment (204, no body)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('commentText', 'Sprint 4 Postman comment ' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204', () => pm.response.to.have.status(204));",
              "pm.test('No response body', () => pm.expect(pm.response.text()).to.eql(''));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/books/{{bookId}}/comments",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"{{userId}}\", \"comment\": \"{{commentText}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "13. List comments: newest first, includes the new one",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const list = pm.response.json();",
              "pm.test('Response is a list', () => pm.expect(list).to.be.an('array'));",
              "pm.test('Newest comment is the one just added', () => pm.expect(list[0].text).to.eql(pm.collectionVariables.get('commentText')));",
              "pm.test('Comment has userId and createdAt datestamp', () => pm.expect(list[0]).to.include.keys('userId', 'text', 'createdAt'));",
              "pm.test('Sorted newest first', () => list.slice(1).forEach((c, i) => pm.expect(new Date(list[i].createdAt) >= new Date(c.createdAt)).to.be.true));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/{{bookId}}/comments"
      }
    },
    {
      "name": "14. Empty comment (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Error message', () => pm.expect(pm.response.json().error).to.eql('comment must be 1–1000 characters'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/books/{{bookId}}/comments",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"{{userId}}\", \"comment\": \"   \"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "15. Comment over 1000 characters (400)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('longComment', 'x'.repeat(1001));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Error message', () => pm.expect(pm.response.json().error).to.eql('comment must be 1–1000 characters'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/books/{{bookId}}/comments",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"{{userId}}\", \"comment\": \"{{longComment}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "16. Comment for missing book (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('Error message', () => pm.expect(pm.response.json().error).to.eql('Book not found'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/books/000000000000000000000000/comments",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"userId\": \"{{userId}}\", \"comment\": \"Hello\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "17. List comments, invalid bookId (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Error message', () => pm.expect(pm.response.json().error).to.eql('Invalid bookId'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/not-an-id/comments"
      }
    },
    {
      "name": "18. Average for a book with no ratings",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('averageRating null, ratingCount 0', () => { pm.expect(r.averageRating).to.eql(null); pm.expect(r.ratingCount).to.eql(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/books/000000000000000000000000/rating"
      }
    }
  ]
}
