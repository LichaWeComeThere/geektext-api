    {
      "name": "7. Create author — 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A new tag each run, so the collection can run again without resetting the data",
              "pm.collectionVariables.set('runTag', String(Date.now()).slice(-7));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const a = pm.response.json();",
              "pm.test('Saved with an _id', () => pm.expect(a._id).to.be.a('string'));",
              "pm.test('Fields saved as sent', () => { pm.expect(a.firstName).to.eql('Smoke'); pm.expect(a.lastName).to.eql('Test ' + pm.collectionVariables.get('runTag')); pm.expect(a.publisher).to.eql('Smoke Test Press'); });",
              "pm.collectionVariables.set('newAuthorId', a._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/authors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "authors"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Smoke\",\n  \"lastName\": \"Test {{runTag}}\",\n  \"biography\": \"Created by the Book Details smoke test.\",\n  \"publisher\": \"Smoke Test Press\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
