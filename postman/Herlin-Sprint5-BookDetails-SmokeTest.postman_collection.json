              "pm.test('Dashes are ignored (same book)', () => pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get('seedBookId')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books/isbn/978-1-7365-0101-6",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books",
            "isbn",
            "978-1-7365-0101-6"
          ]
        }
      }
    },
