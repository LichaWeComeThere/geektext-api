{
  "info": {
    "name": "Herlin — Sprint 5 Book Details Smoke Test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Smoke test for all 4 Book Details routes, in order: get book by ISBN, get books by author, create an author, create a book, then both reads again on the new data. Run node seed/seedBooks.js and start the API first, then run the requests in order. Each run makes a new test author and book, so it can run again without resetting. See docs/BOOK_DETAILS.md."
  },
  "item": [
    {
      "name": "1. Book by ISBN — 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('Right book', () => pm.expect(b.isbn).to.eql(pm.collectionVariables.get('seedIsbn')));",
              "pm.test('Has all book fields', () => ['name', 'description', 'price', 'genre', 'publisher', 'yearPublished', 'copiesSold'].forEach((f) => pm.expect(b).to.have.property(f)));",
              "pm.test('Author name is filled in', () => { pm.expect(b.author.firstName).to.be.a('string'); pm.expect(b.author.lastName).to.be.a('string'); });",
              "pm.collectionVariables.set('authorId', b.author._id);",
              "pm.collectionVariables.set('seedBookId', b._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books/isbn/{{seedIsbn}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books",
            "isbn",
            "{{seedIsbn}}"
          ]
        }
      }
    },
    {
      "name": "2. Same ISBN with dashes — same book",
