    {
      "name": "11. Create book for the new author — 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A random ISBN starting with 97899, so this request always creates a new book",
              "let isbn = '97899';",
              "for (let i = 0; i < 8; i++) isbn += Math.floor(Math.random() * 10);",
              "pm.collectionVariables.set('newIsbn', isbn);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test('Saved with the ISBN sent', () => pm.expect(b.isbn).to.eql(pm.collectionVariables.get('newIsbn')));",
              "pm.test('Author name is filled in', () => { pm.expect(b.author._id).to.eql(pm.collectionVariables.get('newAuthorId')); pm.expect(b.author.firstName).to.eql('Smoke'); });",
              "pm.test('copiesSold defaults to 0', () => pm.expect(b.copiesSold).to.eql(0));"
            ]
          }
        }
      ],
