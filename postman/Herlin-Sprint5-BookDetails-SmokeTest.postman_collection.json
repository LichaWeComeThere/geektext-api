    {
      "name": "4. Books by author — 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const books = pm.response.json();",
              "pm.test('Returns a list with books', () => { pm.expect(books).to.be.an('array'); pm.expect(books.length).to.be.above(0); });",
              "pm.test('Every book is by this author', () => pm.expect(books.every((b) => b.author._id === pm.collectionVariables.get('authorId'))).to.be.true);",
              "const names = books.map((b) => b.name);",
              "pm.test('Sorted by name', () => pm.expect(names).to.eql([...names].sort((a, b) => a.localeCompare(b))));",
              "pm.test('Includes the book from request 1', () => pm.expect(books.map((b) => b.isbn)).to.include(pm.collectionVariables.get('seedIsbn')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
